# Build output at any depth (the workspace and fuzz/), and the fuzzer's working directories,
# ignored here too so a branch without fuzz/.gitignore cannot pick them up.
target/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/
fuzz/seeds/
**/*.rs.bk
.DS_Store
.env
.env.local
*.sqlite*
.vscode/
.idea/
*.swp
*.swo
*~

# Test fixtures: public test certificates only (no private keys).
!crates/*/tests/fixtures/*.pem

# Release archives and images (scripts/package-release.sh)
/dist

# mdBook output (mdbook build docs)
/docs/book
