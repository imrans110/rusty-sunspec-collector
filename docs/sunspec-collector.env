# Example environment overrides for the SunSpec collector.
# Copy to /etc/sunspec-collector.env and adjust for your deployment.
#
# Config hierarchy: compiled defaults -> config file -> env vars (last wins).
# See config.example.toml for the file-based equivalent.

# Optional: point to a TOML/JSON config file. Env vars override file values.
# SUNSPEC_CONFIG=/etc/sunspec-collector.toml

# --- Discovery ---
SUNSPEC_SUBNET=192.168.1.0/24
SUNSPEC_PORT=502
SUNSPEC_STATIC_DEVICES=
SUNSPEC_DISCOVERY_UNIT_IDS=1
# SUNSPEC_RESCAN_INTERVAL_S=600

# --- Observability ---
# Serves /metrics and /healthz. Comments must be on their own line: systemd and
# docker --env-file do not strip trailing comments from values.
SUNSPEC_METRICS_PORT=9090
# SUNSPEC_LOG_FORMAT=json          # text (default) or json
# RUST_LOG=info                     # log filter, e.g. info,poller_actor=debug

# --- Polling ---
SUNSPEC_POLL_INTERVAL_MS=1000
SUNSPEC_REQUEST_TIMEOUT_MS=1000
SUNSPEC_JITTER_MS=0
# SUNSPEC_STALL_TIMEOUT_MS=30000

# --- SunSpec ---
SUNSPEC_BASE_ADDRESS=40000

# --- Modbus ---
# SUNSPEC_MAX_BATCH_SIZE=64

# --- Buffer ---
SUNSPEC_BUFFER_PATH=/var/lib/sunspec-collector/buffer.sqlite
SUNSPEC_BUFFER_BATCH_SIZE=100
SUNSPEC_BUFFER_DRAIN_MS=500
# SUNSPEC_BUFFER_MAX_ROWS=1000000
# SUNSPEC_BUFFER_MAX_AGE_S=604800
# SUNSPEC_SHUTDOWN_DRAIN_TIMEOUT_MS=5000

# --- Internal ---
# SUNSPEC_CHANNEL_CAPACITY=256
# SUNSPEC_RESPAWN_DELAY_MS=1000

# --- Kafka ---
SUNSPEC_KAFKA_BROKERS=localhost:9092
SUNSPEC_KAFKA_TOPIC=sunspec.telemetry
SUNSPEC_KAFKA_CLIENT_ID=sunspec-collector
SUNSPEC_KAFKA_ACKS=all
SUNSPEC_KAFKA_COMPRESSION=zstd
SUNSPEC_KAFKA_TIMEOUT_MS=5000
# SUNSPEC_KAFKA_IDEMPOTENCE=true

# --- Kafka security (see docs/configuration.md and docs/ops.md) ---
# SUNSPEC_KAFKA_SECURITY_PROTOCOL=sasl_ssl
# SUNSPEC_KAFKA_SSL_CA_LOCATION=/etc/sunspec-collector/kafka-ca.pem
# SUNSPEC_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# SUNSPEC_KAFKA_SASL_USERNAME=site-0042
# Keep the password out of this file: use a systemd credential (see the unit file).
# SUNSPEC_KAFKA_SASL_PASSWORD_FILE=/run/credentials/sunspec-collector.service/kafka-password
