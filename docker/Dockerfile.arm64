# Cross-compilation image for aarch64 (see Cross.toml and docs/build.md).
# librdkafka is built from source by rdkafka's cmake-build feature, so only the
# target's OpenSSL and the curl headers librdkafka 2.12 needs at compile time are
# installed. SQLite is bundled by sqlx and zstd by zstd-sys.
FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:latest

RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        cmake \
        pkg-config \
        libssl-dev:arm64 \
        libcurl4-openssl-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
