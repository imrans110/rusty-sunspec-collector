# Cross-compilation image for the release binaries (see Cross.toml and docs/build.md),
# built once per target, for example:
#
#   docker build -t sunspec-cross-aarch64-unknown-linux-gnu -f docker/Dockerfile.cross \
#     --build-arg BASE_IMAGE=ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5@sha256:<digest> \
#     --build-arg DEB_ARCH=arm64 --build-arg MULTIARCH=aarch64-linux-gnu docker
#
# BASE_IMAGE is the target's cross-rs image, pinned by digest; the release workflow passes
# the pinned image for each target, and the default below is the aarch64 one. The cross-rs
# 0.2.5 base images are Ubuntu 16.04, so the binaries need only glibc 2.18 (the newest symbol
# version they use; the release workflow checks it). Pinned to the cross release so a new
# base image cannot raise that floor unnoticed. librdkafka is built from source by
# rdkafka's cmake-build feature. Build with `--features vendored-openssl`: OpenSSL is then
# compiled from source and linked statically (the image's OpenSSL is too old for
# librdkafka 2.12), so the binary does not depend on the target's OpenSSL. Only the curl
# headers librdkafka 2.12 needs at compile time are installed for the target; SQLite is
# bundled by sqlx and zstd by zstd-sys.
ARG BASE_IMAGE=ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5@sha256:7f8308a8734d9fcd2ebbe9a3e4bdea74af293f0799d80c3cc341e340cda49a4c
FROM ${BASE_IMAGE}

# The target's Debian architecture (arm64, amd64) and multiarch directory.
ARG DEB_ARCH=arm64
ARG MULTIARCH=aarch64-linux-gnu

RUN if [ "$(dpkg --print-architecture)" != "${DEB_ARCH}" ]; then \
        dpkg --add-architecture "${DEB_ARCH}"; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        cmake \
        make \
        perl \
        pkg-config \
        "libcurl4-openssl-dev:${DEB_ARCH}" \
    && rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_LIBDIR=/usr/lib/${MULTIARCH}/pkgconfig
ENV PKG_CONFIG_PATH=/usr/lib/${MULTIARCH}/pkgconfig
